# Database
DATABASE_URL="postgresql://username:password@localhost:5432/holiday_hub?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# Resend API (for email notifications)
RESEND_API_KEY="your-resend-api-key"

# Email sender
EMAIL_FROM="Holiday Hub <notifications@yourdomain.com>"


# OAuth Providers (Optional - for social login)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# Web Push (optional - for browser notifications)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_EMAIL="mailto:your-email@example.com"

# Optional Redis URL for rate limiting (e.g. redis://localhost:6379)
# If provided, the app will use Redis for rate limiting; otherwise an in-memory fallback is used.
# REDIS_URL="redis://localhost:6379"

# QStash / Upstash (scheduler)
QSTASH_URL="https://qstash-us-east-1.upstash.io"
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="sig_xxx"
QSTASH_NEXT_SIGNING_KEY="sig_xxx"

# Optional manual fallback for local testing
CRON_SECRET="a_random_string_for_local_testing"
