# Example .env.local for local development
# Copy this to .env.local and fill in real secrets

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret

# Google OAuth (create in Google Cloud Console)
# Authorized redirect URI (exact): http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (create in GitHub OAuth Apps)
# Authorization callback URL (exact): http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=
